from .. import loader, utils
import requests

@loader.tds
class AIGenV2(loader.Module):
    """AI Module Generator v2 | made by @dexonbuy"""

    strings = {"name": "AIGenV2"}

    async def client_ready(self, client, db):
        self.db = db
        self.client = client

    async def aikeycmd(self, message):
        """<key> — установить OpenRouter API ключ"""
        key = utils.get_args_raw(message)

        if not key:
            await utils.answer(message, "❌ Укажи API ключ")
            return

        self.db.set("AIGEN", "key", key)
        await utils.answer(message, "✅ API ключ сохранён")

    async def aigencmd(self, message):
        """<описание> — сгенерировать модуль"""

        prompt = utils.get_args_raw(message)

        if not prompt:
            await utils.answer(message, "❌ Напиши что создать")
            return

        key = self.db.get("AIGEN", "key")

        if not key:
            await utils.answer(message, "❌ Нет API ключа (.aikey)")
            return

        headers = {
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json"
        }

        data = {
            "model": "openai/gpt-4o-mini",
            "messages": [
                {
                    "role": "system",
                    "content": (
                        "Ты генерируешь ТОЛЬКО Python модули для Telegram userbot. "
                        "Не добавляй вредоносный код, взлом, удаление аккаунтов. "
                        "Только полезные команды и функции."
                    )
                },
                {
                    "role": "user",
                    "content": f"Создай модуль для userbot: {prompt}"
                }
            ]
        }

        try:
            r = requests.post(
                "https://openrouter.ai/api/v1/chat/completions",
                headers=headers,
                json=data,
                timeout=30
            )

            result = r.json()

            if "choices" not in result:
                await utils.answer(message, f"❌ Ошибка API\n{result}")
                return

            code = result["choices"][0]["message"]["content"]

            # защита от огромных ответов
            if len(code) > 3500:
                code = code[:3500] + "\n\n... (cut)"

            await utils.answer(message, f"```python\n{code}\n```")

        except Exception as e:
            await utils.answer(message, f"❌ Error:\n{e}")
